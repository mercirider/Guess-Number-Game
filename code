<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎯 Guess The Number (1-10)</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, sans-serif;
  }

  html, body {
    height: 100%;
    overflow: hidden;
  }

  body {
    display: flex;
    justify-content: center;
    align-items: center;
    background: #0a0a1a;
    position: relative;
    padding: 20px;
  }

  /* Animated background glow circles */
  body::before,
  body::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.5;
    z-index: 0;
  }

  body::before {
    width: 500px;
    height: 500px;
    background: #667eea;
    top: -150px;
    left: -150px;
    animation: float1 8s ease-in-out infinite;
  }

  body::after {
    width: 500px;
    height: 500px;
    background: #f5576c;
    bottom: -150px;
    right: -150px;
    animation: float2 10s ease-in-out infinite;
  }

  @keyframes float1 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(80px, 60px); }
  }

  @keyframes float2 {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(-80px, -60px); }
  }

  /* Main Card */
  .game-container {
    position: relative;
    z-index: 2;
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 32px;
    padding: 50px 45px;
    width: 100%;
    max-width: 720px;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    text-align: center;
    animation: cardIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes cardIn {
    from { transform: translateY(40px) scale(0.95); opacity: 0; }
    to   { transform: translateY(0) scale(1); opacity: 1; }
  }

  /* Title */
  .title {
    font-size: 46px;
    font-weight: 900;
    background: linear-gradient(135deg, #a78bfa, #f472b6, #60a5fa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 10px;
    letter-spacing: -1px;
  }

  .subtitle {
    color: rgba(255, 255, 255, 0.55);
    font-size: 16px;
    margin-bottom: 35px;
    font-weight: 500;
  }

  /* Stats row */
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 15px;
    margin-bottom: 35px;
  }

  .stat-box {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 18px 10px;
    transition: all 0.3s;
  }

  .stat-box:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.1);
  }

  .stat-label {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .stat-value {
    color: #fff;
    font-size: 32px;
    font-weight: 800;
  }

  .stat-value.pink  { color: #f472b6; }
  .stat-value.blue  { color: #60a5fa; }
  .stat-value.green { color: #34d399; }

  /* Number grid 1-10 */
  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-bottom: 30px;
  }

  .num-btn {
    aspect-ratio: 1;
    border: 2px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    color: #fff;
    font-size: 28px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    font-family: inherit;
  }

  .num-btn:hover:not(:disabled) {
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-color: transparent;
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 15px 30px rgba(102, 126, 234, 0.4);
  }

  .num-btn:active:not(:disabled) {
    transform: translateY(-2px) scale(0.98);
  }

  .num-btn:disabled {
    cursor: not-allowed;
    opacity: 0.3;
  }

  /* After guess feedback */
  .num-btn.low {
    background: rgba(251, 191, 36, 0.15);
    border-color: #fbbf24;
    color: #fbbf24;
    opacity: 1;
  }

  .num-btn.high {
    background: rgba(96, 165, 250, 0.15);
    border-color: #60a5fa;
    color: #60a5fa;
    opacity: 1;
  }

  .num-btn.win {
    background: linear-gradient(135deg, #10b981, #34d399);
    border-color: transparent;
    color: #fff;
    opacity: 1;
    animation: winPulse 0.6s ease infinite alternate;
    box-shadow: 0 0 40px rgba(52, 211, 153, 0.7);
  }

  @keyframes winPulse {
    from { transform: scale(1); }
    to   { transform: scale(1.08); }
  }

  /* Message */
  .message {
    min-height: 70px;
    padding: 20px 25px;
    border-radius: 20px;
    font-weight: 700;
    font-size: 18px;
    margin-bottom: 25px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.35s;
    line-height: 1.4;
  }

  .message.low {
    background: rgba(251, 191, 36, 0.12);
    border-color: rgba(251, 191, 36, 0.4);
    color: #fbbf24;
  }

  .message.high {
    background: rgba(96, 165, 250, 0.12);
    border-color: rgba(96, 165, 250, 0.4);
    color: #60a5fa;
  }

  .message.win {
    background: rgba(52, 211, 153, 0.15);
    border-color: rgba(52, 211, 153, 0.5);
    color: #34d399;
    font-size: 22px;
    animation: pop 0.5s;
  }

  .message.lose {
    background: rgba(239, 68, 68, 0.15);
    border-color: rgba(239, 68, 68, 0.5);
    color: #f87171;
    font-size: 20px;
  }

  @keyframes pop {
    0%   { transform: scale(0.8); }
    50%  { transform: scale(1.05); }
    100% { transform: scale(1); }
  }

  /* Restart button */
  .restart-btn {
    width: 100%;
    padding: 20px;
    border: none;
    border-radius: 20px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: #fff;
    font-size: 18px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s;
    letter-spacing: 0.5px;
    display: none;
    box-shadow: 0 10px 30px rgba(102, 126, 234, 0.35);
  }

  .restart-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(102, 126, 234, 0.55);
  }

  .restart-btn:active { transform: translateY(0); }

  .restart-btn.show {
    display: block;
    animation: pop 0.5s;
  }

  /* Confetti */
  .confetti {
    position: fixed;
    width: 10px;
    height: 10px;
    background: #f472b6;
    top: -20px;
    z-index: 999;
    pointer-events: none;
    animation: fall 3s linear forwards;
  }

  @keyframes fall {
    to {
      transform: translateY(105vh) rotate(720deg);
      opacity: 0;
    }
  }

  /* Responsive */
  @media (max-width: 600px) {
    .game-container { padding: 35px 22px; border-radius: 24px; }
    .title { font-size: 32px; }
    .subtitle { font-size: 14px; margin-bottom: 25px; }
    .stat-value { font-size: 24px; }
    .numbers-grid { gap: 10px; }
    .num-btn { font-size: 22px; border-radius: 16px; }
    .message { font-size: 15px; padding: 16px; min-height: 60px; }
    .restart-btn { font-size: 16px; padding: 16px; }
  }
</style>
</head>
<body>

<div class="game-container">
  <h1 class="title">🎯 Guess The Number</h1>
  <p class="subtitle">Maine 1 se 10 ke beech ek number socha hai — dhoondho!</p>

  <!-- Stats -->
  <div class="stats">
    <div class="stat-box">
      <div class="stat-label">Range</div>
      <div class="stat-value blue">1-10</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Chances</div>
      <div class="stat-value pink" id="attemptsLeft">3</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">Tries</div>
      <div class="stat-value green" id="triesCount">0</div>
    </div>
  </div>

  <!-- Numbers Grid 1-10 -->
  <div class="numbers-grid" id="numbersGrid"></div>

  <!-- Message -->
  <div class="message" id="message">Apna number choose karein 👆</div>

  <!-- Restart -->
  <button class="restart-btn" id="restartBtn">🔄 Naya Game Khelein</button>
</div>

<script>
/* ---------- Config ---------- */
const MIN = 1;
const MAX = 10;
const MAX_ATTEMPTS = 3;

/* ---------- State ---------- */
let secretNumber = 0;
let attemptsLeft = 0;
let tries = 0;
let gameOver = false;

/* ---------- DOM ---------- */
const numbersGrid = document.getElementById('numbersGrid');
const messageEl = document.getElementById('message');
const attemptsLeftEl = document.getElementById('attemptsLeft');
const triesCountEl = document.getElementById('triesCount');
const restartBtn = document.getElementById('restartBtn');

/* ---------- Build Numbers Grid ---------- */
function buildGrid() {
  numbersGrid.innerHTML = '';
  for (let i = MIN; i <= MAX; i++) {
    const btn = document.createElement('button');
    btn.className = 'num-btn';
    btn.textContent = i;
    btn.dataset.num = i;
    btn.addEventListener('click', () => handleGuess(i, btn));
    numbersGrid.appendChild(btn);
  }
}

/* ---------- Start New Game ---------- */
function startGame() {
  secretNumber = Math.floor(Math.random() * (MAX - MIN + 1)) + MIN;
  attemptsLeft = MAX_ATTEMPTS;
  tries = 0;
  gameOver = false;

  attemptsLeftEl.textContent = attemptsLeft;
  triesCountEl.textContent = tries;
  messageEl.textContent = 'Apna number choose karein 👆';
  messageEl.className = 'message';
  restartBtn.classList.remove('show');

  buildGrid();
}

/* ---------- Handle Guess ---------- */
function handleGuess(num, btn) {
  if (gameOver || btn.disabled) return;

  tries++;
  attemptsLeft--;
  triesCountEl.textContent = tries;
  attemptsLeftEl.textContent = attemptsLeft;

  if (num === secretNumber) {
    // WIN
    gameOver = true;
    btn.classList.add('win');
    messageEl.textContent = `🎉 Shabash! Sahi number ${secretNumber} tha! ${tries} tries mein jeeta!`;
    messageEl.className = 'message win';
    disableAllExcept(btn);
    restartBtn.classList.add('show');
    launchConfetti();
  } else {
    // WRONG
    btn.disabled = true;
    btn.classList.add(num < secretNumber ? 'low' : 'high');

    if (attemptsLeft === 0) {
      // LOSE
      gameOver = true;
      messageEl.textContent = `😢 Game Over! Sahi number tha: ${secretNumber}`;
      messageEl.className = 'message lose';
      disableAllExcept(null);
      // reveal the answer
      const correctBtn = [...numbersGrid.children].find(b => +b.dataset.num === secretNumber);
      if (correctBtn) correctBtn.classList.add('win');
      restartBtn.classList.add('show');
    } else if (num < secretNumber) {
      messageEl.textContent = `📉 Chhota hai! Thoda bada try karein. (${attemptsLeft} chances left)`;
      messageEl.className = 'message low';
    } else {
      messageEl.textContent = `📈 Bada hai! Thoda chhota try karein. (${attemptsLeft} chances left)`;
      messageEl.className = 'message high';
    }
  }
}

/* ---------- Disable all buttons ---------- */
function disableAllExcept(keepBtn) {
  [...numbersGrid.children].forEach(btn => {
    if (btn !== keepBtn) btn.disabled = true;
  });
}

/* ---------- Confetti ---------- */
function launchConfetti() {
  const colors = ['#f472b6', '#60a5fa', '#34d399', '#fbbf24', '#a78bfa', '#f87171'];
  for (let i = 0; i < 60; i++) {
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.left = Math.random() * 100 + 'vw';
    c.style.background = colors[Math.floor(Math.random() * colors.length)];
    c.style.animationDelay = Math.random() * 0.5 + 's';
    c.style.animationDuration = (2 + Math.random() * 2) + 's';
    c.style.width = c.style.height = (6 + Math.random() * 8) + 'px';
    c.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 4000);
  }
}

/* ---------- Restart ---------- */
restartBtn.addEventListener('click', startGame);

/* ---------- Init ---------- */
startGame();
</script>

</body>
</html>
